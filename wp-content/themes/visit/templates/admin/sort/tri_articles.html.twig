<div class="wrap">
    <h1>Tri des articles pour la catégorie <a href="{{ categoryUrl }}" target="_blank">{{ category.name }} <span class="dashicons dashicons-external"></span></a></h1>

    <div id="ajax-response"></div>

    <div id="order-post-type">
        <ul id="sortable">
            {% for item in items %}
                <li class="ui-sortable-handle" id="item_{{ item.id }}" style="cursor: move; padding: 8px 12px; margin: 4px 0; background: #fff; border: 1px solid #ccc; border-radius: 3px;">
                    <span class="dashicons dashicons-menu" style="margin-right: 8px; color: #999;"></span>
                    <strong>{{ item.name }}</strong>
                    <span style="margin-left: 8px; color: #999; font-size: 12px;">({{ item.type.value }})</span>
                </li>
            {% endfor %}
        </ul>
        <div class="clear"></div>
    </div>

    <p class="submit">
        <button id="save-order" class="button button-primary">Sauvegarder</button>
    </p>

    <script type="text/javascript">
        jQuery(document).ready(function ($) {
            $('#sortable').sortable({
                tolerance: 'intersect',
                cursor: 'pointer',
                items: 'li',
                placeholder: 'sortable-placeholder',
            }).disableSelection();

            $('#save-order').on('click', function (e) {
                e.preventDefault();
                var order = [];
                $('#sortable li').each(function () {
                    order.push($(this).attr('id').replace('item_', ''));
                });

                $.post(ajaxurl, {
                    action: 'visit_sort_save',
                    nonce: '{{ nonce }}',
                    cat_id: {{ category.cat_ID }},
                    order: order
                }, function () {
                    $('#ajax-response')
                        .html('<div class="notice notice-success is-dismissible"><p>L\'ordre a bien été enregistré.</p></div>')
                        .find('div').delay(3000).fadeOut('slow');
                }).fail(function () {
                    $('#ajax-response')
                        .html('<div class="notice notice-error"><p>Erreur lors de la sauvegarde.</p></div>');
                });
            });
        });
    </script>

    <style>
        .sortable-placeholder {
            background: #f0f0f1;
            border: 2px dashed #c3c4c7;
            height: 40px;
            margin: 4px 0;
            border-radius: 3px;
        }
    </style>
</div>
