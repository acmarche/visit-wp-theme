<section id="content">
    <main class="container mx-auto px-4 py-8">
        <h1 class="text-3xl md:text-4xl font-bold text-caractere mb-6">
            Carte des balades
        </h1>

        <div id="map-balades" style="height: 600px; border-radius: 12px;" class="shadow-lg z-0"></div>

        <p class="mt-4 text-sm text-gray-500">
            {{ markers|length }} balades disponibles.
            Cliquez sur un marqueur pour voir le parcours GPX.
        </p>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var markers = {{ markersJson|raw }};

            var map = L.map('map-balades').setView([50.35, 5.35], 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                maxZoom: 18
            }).addTo(map);

            var gpxLayer = null;
            var bounds = L.latLngBounds();

            var defaultIcon = L.divIcon({
                html: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#1a6847" width="32" height="32"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>',
                iconSize: [32, 32],
                iconAnchor: [16, 32],
                popupAnchor: [0, -32],
                className: ''
            });

            var activeIcon = L.divIcon({
                html: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#c85a1a" width="40" height="40"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>',
                iconSize: [40, 40],
                iconAnchor: [20, 40],
                popupAnchor: [0, -40],
                className: ''
            });

            var activeMarker = null;
            var markerObjects = [];

            markers.forEach(function (item) {
                var popupHtml = '<div style="min-width:200px;max-width:280px;">';
                if (item.image) {
                    popupHtml += '<img src="' + item.image + '" alt="' + item.name + '" style="width:100%;height:120px;object-fit:cover;border-radius:6px 6px 0 0;margin-bottom:8px;">';
                }
                popupHtml += '<strong style="font-size:14px;">' + item.name + '</strong>';
                if (item.distance) {
                    popupHtml += '<br><span style="color:#666;font-size:12px;">' + item.distance + ' km</span>';
                }
                if (item.excerpt) {
                    popupHtml += '<p style="font-size:12px;color:#555;margin:6px 0;">' + item.excerpt.substring(0, 120) + (item.excerpt.length > 120 ? '...' : '') + '</p>';
                }
                if (item.gpx.length > 0) {
                    popupHtml += '<button class="gpx-btn" data-gpx=\'' + JSON.stringify(item.gpx) + '\' style="display:inline-block;margin:6px 0;padding:5px 12px;background:#1a6847;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:12px;">Voir le parcours</button>';
                }
                popupHtml += '<br><a href="' + item.url + '" style="color:#1a6847;font-size:12px;text-decoration:underline;">Voir la fiche</a>';
                popupHtml += '</div>';

                var marker = L.marker([item.lat, item.lng], {icon: defaultIcon})
                    .addTo(map)
                    .bindPopup(popupHtml);

                marker._itemData = item;
                markerObjects.push(marker);
                bounds.extend([item.lat, item.lng]);
            });

            if (bounds.isValid()) {
                map.fitBounds(bounds, {padding: [40, 40]});
            }

            map.on('popupopen', function (e) {
                var popup = e.popup;
                var btn = popup.getElement().querySelector('.gpx-btn');
                if (btn) {
                    btn.addEventListener('click', function () {
                        var gpxUrls = JSON.parse(this.getAttribute('data-gpx'));
                        loadGpx(gpxUrls, e.popup._source);
                    });
                }
            });

            function loadGpx(gpxUrls, marker) {
                if (gpxLayer) {
                    map.removeLayer(gpxLayer);
                    gpxLayer = null;
                }

                if (activeMarker) {
                    activeMarker.setIcon(defaultIcon);
                }
                marker.setIcon(activeIcon);
                activeMarker = marker;

                gpxLayer = L.featureGroup().addTo(map);

                gpxUrls.forEach(function (url) {
                    new L.GPX(url, {
                        async: true,
                        polyline_options: {
                            color: '#c85a1a',
                            weight: 4,
                            opacity: 0.8,
                            lineCap: 'round'
                        },
                        marker_options: {
                            startIconUrl: null,
                            endIconUrl: null,
                            shadowUrl: null,
                            wptIconUrls: {
                                '': null
                            }
                        }
                    }).on('loaded', function (e) {
                        gpxLayer.addLayer(e.target);
                        map.fitBounds(gpxLayer.getBounds(), {padding: [40, 40]});
                    }).on('error', function (e) {
                        console.warn('GPX load error:', e);
                    });
                });
            }
        });
    </script>
</section>
