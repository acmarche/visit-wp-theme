{# === PROMOTIONAL MODAL: "Statues en Marche" campaign ===
   Auto-opens once per browser session (sessionStorage). Recreates the
   campaign artwork in responsive HTML so the text stays selectable,
   accessible and translatable. #}
<div x-data="{
        open: false,
        init() {
            if (sessionStorage.getItem('statuesModalSeen') !== '1') {
                this.open = true;
                document.body.style.overflow = 'hidden';
                this.setInert(true);
                this.$nextTick(() => { this.$refs.dialog?.focus(); });
            }
        },
        close() {
            this.open = false;
            document.body.style.overflow = '';
            this.setInert(false);
            sessionStorage.setItem('statuesModalSeen', '1');
        },
        setInert(state) {
            const root = this.$root;
            for (const el of root.parentElement.children) {
                if (el !== root) el.inert = state;
            }
        },
        trap(e) {
            const f = this.$refs.dialog.querySelectorAll('a[href],button:not([disabled])');
            if (!f.length) return;
            const first = f[0], last = f[f.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
     }"
     x-cloak
     x-show="open"
     x-transition.opacity.duration.300ms
     @keydown.escape.window="close()"
     class="fixed inset-0 z-100 flex items-center justify-center p-3 sm:p-6">

    {# Backdrop #}
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="close()" aria-hidden="true"></div>

    {# Card #}
    <div x-show="open"
         x-ref="dialog"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="statues-modal-title"
         @keydown.tab="trap($event)"
         x-transition:enter="transition ease-out duration-300"
         x-transition:enter-start="opacity-0 scale-95"
         x-transition:enter-end="opacity-100 scale-100"
         class="relative w-full max-w-5xl max-h-[92vh] overflow-y-auto rounded-3xl shadow-2xl focus:outline-none"
         style="background-color:#f4efe6;">

        {# Close button #}
        <button type="button"
                @click="close()"
                aria-label="{{ 'close'|trans|default('Fermer') }}"
                class="absolute top-4 right-4 z-20 grid place-items-center w-11 h-11 rounded-full bg-white text-gray-700 shadow-md hover:bg-gray-100 hover:text-gray-900 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cta-dark focus-visible:ring-offset-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
                 aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        {# Badge — straddles the column boundary so it overlaps the statue edge #}
        <div class="hidden sm:flex absolute z-20 flex-col items-center justify-center text-center
                    w-28 h-28 rounded-full text-white p-3 shadow-xl ring-4 ring-[#f4efe6]
                    top-24 right-6 lg:top-1/3 lg:left-1/2 lg:right-auto lg:-translate-x-1/2 lg:-translate-y-1/2"
             style="background-color:#1d2b3a;">
            <svg class="w-5 h-5 mb-1" style="color:#9bbf6f;" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path
                    d="M12 21s-6.716-4.35-9.428-7.062a5 5 0 1 1 7.07-7.07L12 8.226l2.358-1.358a5 5 0 1 1 7.07 7.07C18.716 16.65 12 21 12 21z"/>
            </svg>
            <span class="text-[0.7rem] leading-snug font-medium">Restez plus longtemps, créez plus de souvenirs</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2">

            {# ===== LEFT: content ===== #}
            <div class="p-6 sm:p-8 lg:p-6 flex flex-col">
                <img src="{{ template_uri() }}/assets/images/VisitLogoBlack.png"
                     alt="Visit Marche"
                     class="h-14 sm:h-16 w-auto object-contain"/>

                <div class="mt-6">
                    <h2 id="statues-modal-title"
                        class="text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight"
                        style="color:#3f4d2e;">
                        <a href="/inspirations/statues-en-marche/"
                           class="hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cta-dark focus-visible:ring-offset-2 rounded">
                            Statues en Marche,<br>
                            et si vous viviez<br>
                            l'expérience complète&nbsp;?
                        </a>
                    </h2>
                </div>

                {# Category icons #}
                <ul class="mt-8 grid grid-cols-5 gap-1 sm:gap-3">
                    {% set cats = [
                        { label: 'VISITER',   desc: 'Explorez notre patrimoine et laissez-vous surprendre !',          color: '#487f89', url:'/categorie/decouvrir/' },
                        { label: 'MANGER',    desc: 'Savourez nos produits locaux.',                                   color: '#e07a5f', url:'/categorie/sorganiser/savourer/' },
                        { label: 'DORMIR',    desc: 'Séjournez dans nos hôtels, chambres d\'hôtes ou hébergements de charme.', color: '#487f89',url:'/categorie/sorganiser/sejourner/' },
                        { label: 'BOUGER',    desc: 'Balades en pleine nature, activités sportives, visites guidées… il y en a pour tous les goûts !', color: '#64966f',url:'/categorie/decouvrir/balades/' },
                        { label: 'S\'INSPIRER', desc: 'Flânez, faites du shopping local et profitez de l\'ambiance chaleureuse de Marche.', color: '#d98a9a',url:'/categorie/inspirations/' }
                    ] %}
                    {% for cat in cats %}
                        <li class="flex">
                            <a href="{{ cat.url }}"
                               aria-label="{{ cat.label }}. {{ cat.desc }}"
                               class="group flex flex-col items-center text-center w-full rounded-xl p-1 transition-colors hover:bg-black/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cta-dark focus-visible:ring-offset-2">
                            <span class="grid place-items-center w-9 h-9 sm:w-10 sm:h-10 transition-transform motion-safe:group-hover:scale-110"
                                  style="color:{{ cat.color }};">
                                {% if loop.index == 1 %}
                                    <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path
                                            stroke-linecap="round" stroke-linejoin="round"
                                            d="M5 7h1a2 2 0 0 0 2-2 1 1 0 0 1 1-1h6a1 1 0 0 1 1 1 2 2 0 0 0 2 2h1a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2"/><circle
                                            cx="12" cy="13" r="3"/></svg>
                                {% elseif loop.index == 2 %}
                                    <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path
                                            stroke-linecap="round" stroke-linejoin="round"
                                            d="M19 3v12h-5c-.023-3.681.184-7.406 5-12zm0 12v6M8 3v17M5 3v3a3 3 0 1 0 6 0V3"/></svg>
                                {% elseif loop.index == 3 %}
                                    <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path
                                            stroke-linecap="round" stroke-linejoin="round"
                                            d="M3 7v11m0-4h18m0 4v-8a2 2 0 0 0-2-2h-8v6M3 12a2 2 0 1 1 4 0 2 2 0 0 1-4 0"/></svg>
                                {% elseif loop.index == 4 %}
                                    <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="5"
                                                                                                             cy="18"
                                                                                                             r="3"/><circle
                                            cx="19" cy="18" r="3"/><path stroke-linecap="round" stroke-linejoin="round"
                                                                         d="M12 19v-4l-3-3 5-4 2 3h3"/><circle cx="17"
                                                                                                               cy="5"
                                                                                                               r="1"/></svg>
                                {% else %}
                                    <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24"
                                         stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path
                                            stroke-linecap="round" stroke-linejoin="round"
                                            d="M6.33 8h11.34a2 2 0 0 1 1.98 2.3l-1.26 8.16a3 3 0 0 1-2.96 2.54H9.57a3 3 0 0 1-2.96-2.54L5.35 10.3A2 2 0 0 1 7.33 8M9 11V6a3 3 0 0 1 6 0v5"/></svg>
                                {% endif %}
                            </span>
                            <span class="mt-2 w-full text-[0.55rem] sm:text-[0.85rem] leading-tight font-bold tracking-normal sm:tracking-wide whitespace-nowrap group-hover:underline"
                                  style="color:#3f4d2e;">{{ cat.label }}</span>
                            <span
                                class="mt-1 text-[0.72rem] leading-tight text-gray-600 hidden sm:block">{{ cat.desc }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>

                {# Partner logos (white logos on a dark chip so they read on the cream card) #}
                <div class="mt-auto pt-8">
                    <div class="inline-flex items-center gap-5 px-5 py-3 rounded-2xl" style="background-color:#1d2b3a;">
                       <a href="https://www.marche.be/"> <img src="{{ template_uri() }}/assets/images/marche_logo.png"
                             alt="Marche-en-Famenne"
                             class="h-9 sm:h-10 w-auto object-contain"/></a>
                        <span class="h-8 w-px bg-white/25" aria-hidden="true"></span>
                        <a href="https://visitwallonia.be/"> <img src="{{ template_uri() }}/assets/images/VISITWallonia-horizontal-blanc.svg"
                             alt="Visit Wallonia"
                             class="h-7 sm:h-8 w-auto object-contain"/>
                        </a>
                    </div>
                </div>
            </div>

            {# ===== RIGHT: imagery ===== #}
            <div
                class="relative min-h-[300px] sm:min-h-[380px] lg:min-h-full overflow-hidden rounded-b-3xl lg:rounded-b-none lg:rounded-r-3xl"
                style="background-color:#1d2b3a;">
                {# Statue (fills the panel like the original artwork) #}
                <img src="{{ template_uri() }}/assets/images/modal/statue.jpg"
                     alt="Statue vivante en bronze à Marche-en-Famenne"
                     class="absolute inset-0 h-full w-full object-cover object-top"/>
                {# Gradient to blend into the cream card and lift the overlays #}
                <div
                    class="absolute inset-0 bg-linear-to-br from-[#1d2b3a]/40 via-transparent to-[#1d2b3a]/70 lg:bg-linear-to-r lg:from-[#f4efe6] lg:via-transparent lg:to-[#1d2b3a]/50"
                    aria-hidden="true"></div>

                {# Photo collage #}
                <div class="absolute bottom-4 right-3 sm:bottom-6 sm:right-6 hidden sm:flex items-end gap-2 sm:gap-3">
                    <img src="{{ template_uri() }}/assets/images/modal/velo.jpg"
                         alt="Balade à vélo en famille"
                         class="w-20 h-24 sm:w-28 sm:h-32 object-cover rounded-lg shadow-xl ring-2 ring-white rotate-[-4deg]"/>
                    <img src="{{ template_uri() }}/assets/images/modal/patrimoine.jpg"
                         alt="Patrimoine bâti et jardins"
                         class="w-20 h-28 sm:w-28 sm:h-40 object-cover rounded-lg shadow-xl ring-2 ring-white"/>
                    <img src="{{ template_uri() }}/assets/images/modal/gourmandise.jpg"
                         alt="Gastronomie et produits locaux"
                         class="w-20 h-24 sm:w-28 sm:h-32 object-cover rounded-lg shadow-xl ring-2 ring-white rotate-[4deg]"/>
                </div>

                {# Location pill #}
                <div
                    class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/90 backdrop-blur text-gray-800 text-xs sm:text-sm font-medium shadow-lg">
                    <svg class="w-4 h-4 text-cta-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                         stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    Marche au cœur de la Famenne
                    <span style="color:#64966f;">♥</span>
                </div>
            </div>
        </div>
    </div>
</div>
